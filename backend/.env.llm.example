# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Configure one or more LLM providers for the chatbot
# The system will try providers in order: Primary → Fallbacks
#
# RECOMMENDATION FOR PRODUCTION:
# - Primary: GEMINI_API_KEY (free tier, fast, reliable)
# - Fallback 1: TOGETHER_API_KEY (pay-per-use, cheap)
# - Fallback 2: Ollama (local, for development)
# =============================================================================

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (RECOMMENDED - FREE TIER)
# -----------------------------------------------------------------------------
# Get API key: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min, 1500 requests/day
# Paid tier: $0.075 per 1M tokens (very cheap)
#
# Installation: pip install google-generativeai
#
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# TOGETHER AI (RECOMMENDED FOR SCALE)
# -----------------------------------------------------------------------------
# Get API key: https://api.together.xyz/settings/api-keys
# Pricing: $0.20 per 1M tokens (Mistral-7B)
# $25 free credits on signup
#
# Installation: pip install together
#
TOGETHER_API_KEY=your-together-api-key-here

# -----------------------------------------------------------------------------
# HUGGING FACE (FREE TIER AVAILABLE)
# -----------------------------------------------------------------------------
# Get token: https://huggingface.co/settings/tokens
# Free tier: Rate limited, slower
# PRO tier: $9/month for better limits
#
# Installation: pip install huggingface_hub
#
HUGGINGFACE_TOKEN=your-huggingface-token-here

# -----------------------------------------------------------------------------
# OPENAI (HIGHEST QUALITY, PAID)
# -----------------------------------------------------------------------------
# Get API key: https://platform.openai.com/api-keys
# Pricing: $0.50/1M tokens (GPT-3.5), $10/1M tokens (GPT-4)
#
# Installation: pip install openai
#
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# ANTHROPIC CLAUDE (BALANCED, PAID)
# -----------------------------------------------------------------------------
# Get API key: https://console.anthropic.com/settings/keys
# Pricing: $0.25/1M input, $1.25/1M output (Haiku)
#
# Installation: pip install anthropic
#
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# OLLAMA (LOCAL, FREE, PRIVATE)
# -----------------------------------------------------------------------------
# Download: https://ollama.com/download
# Installation: No API key needed
# Storage: 3.8GB for llama2:7b
#
# Commands:
#   ollama pull llama2
#   ollama serve
#
OLLAMA_API_URL=http://localhost:11434

# =============================================================================
# COST ESTIMATION (1000 users/day, 3 conversations each)
# =============================================================================
#
# GEMINI FREE TIER:
#   - Requests: 1000 × 3 = 3000/day (within 21,600/day limit)
#   - Cost: $0/month ✅
#
# GEMINI PAID TIER:
#   - Tokens: 3000 × 800 = 2.4M tokens/day
#   - Cost: 2.4M × $0.075 / 1M = $0.18/day = $5.40/month ✅
#
# TOGETHER AI (Mistral-7B):
#   - Tokens: 2.4M tokens/day
#   - Cost: 2.4M × $0.20 / 1M = $0.48/day = $14.40/month ✅
#
# OPENAI (GPT-3.5):
#   - Tokens: 2.4M tokens/day
#   - Cost: 2.4M × $0.50 / 1M = $1.20/day = $36/month ⚠️
#
# OLLAMA (Local):
#   - Cost: $0/month (API calls)
#   - Server: $60-200/month (t3.large EC2 + 8GB RAM)
#   - Storage: $2/month (20GB)
#   - Total: $62-202/month ❌
#
# =============================================================================

# =============================================================================
# DEPLOYMENT RECOMMENDATIONS
# =============================================================================
#
# DEVELOPMENT (Local):
# 1. Use Ollama (already installed)
# 2. Free, private, no API keys needed
#
# PRODUCTION (Hosting):
# 1. PRIMARY: Use GEMINI_API_KEY (free tier is generous)
# 2. FALLBACK: Use TOGETHER_API_KEY (cheap, reliable)
# 3. REMOVE: Ollama (too much storage/RAM for cloud)
#
# SCALING (High Traffic):
# 1. Start with Gemini free tier (up to 21K requests/day)
# 2. Auto-upgrade to paid Gemini ($5/month for 100K requests)
# 3. Fallback to Together AI if Gemini rate limited
#
# =============================================================================

# =============================================================================
# QUICK START GUIDE
# =============================================================================
#
# 1. GET GEMINI API KEY (5 minutes, FREE):
#    - Visit: https://makersuite.google.com/app/apikey
#    - Click "Create API Key"
#    - Copy and paste above
#
# 2. INSTALL LIBRARY:
#    pip install google-generativeai
#
# 3. TEST:
#    python -c "import google.generativeai as genai; genai.configure(api_key='YOUR_KEY'); print('✅ Gemini configured!')"
#
# 4. RESTART BACKEND:
#    The chatbot will now use Gemini instead of Ollama!
#
# =============================================================================

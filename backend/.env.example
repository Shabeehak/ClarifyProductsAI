# ========================================
# ClarifyProducts.AI Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ========================================
# CACHE - OPTIONAL (for Docker deployment)
# ========================================
# Redis is used for caching API responses (not required for local development)
REDIS_URL=redis://localhost:6379/0

# ========================================
# APPLICATION SETTINGS
# ========================================
APP_NAME=ClarifyProducts.AI
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8501

# ========================================
# OPEN-SOURCE ML MODELS - FREE (Recommended)
# ========================================
# Use free local models instead of paid APIs
USE_LOCAL_MODELS=True

# Hugging Face model names (free to use)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
SUMMARIZATION_MODEL_NAME=facebook/bart-large-cnn


# ========================================
# GOOGLE GEMINI API - REQUIRED
# ========================================
# Used for: LLM chatbot (RAG), fallback summarization, product recognition
# Get free key: https://makersuite.google.com/app/apikey (1500 requests/day free)
GEMINI_API_KEY=

# ========================================
# SERPAPI - REQUIRED
# ========================================
# Used for: Real-time review aggregation from YouTube, Reddit, Google
# Get free key: https://serpapi.com/ (100 searches/month free)
SERPAPI_KEY=

# YouTube Data API v3 (optional - for direct video reviews)
# Get free key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ========================================
# REDDIT API - OPTIONAL
# ========================================
# Get credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ClarifyProducts.AI/1.0


# ========================================
# IMPORTANT NOTES
# ========================================
# 1. Never commit the actual .env file to git!
# 2. .env is already in .gitignore
# 3. GEMINI_API_KEY and SERPAPI_KEY are required for the application to work
# 4. ML models are downloaded automatically at runtime (no manual setup needed)
# 5. Reddit API is optional (used for additional review sources)

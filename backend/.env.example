# ========================================
# ClarifyProducts.AI Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ========================================
# DATABASE - REQUIRED
# ========================================
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/clarifyproducts
REDIS_URL=redis://localhost:6379/0

# ========================================
# SECURITY - REQUIRED
# ========================================
# Generate a strong secret key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-random-string-min-32-chars

# JWT signing algorithm
# HMAC (symmetric - uses SECRET_KEY): HS256, HS384, HS512
# RSA (asymmetric - requires key pair): RS256, RS384, RS512
# ECDSA (asymmetric - requires key pair): ES256, ES384, ES512
# Recommended: HS256 for simple setups, RS256 for microservices
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# APPLICATION SETTINGS
# ========================================
APP_NAME=ClarifyProducts.AI
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8501

# ========================================
# OPEN-SOURCE ML MODELS - FREE (Recommended)
# ========================================
# Use free local models instead of paid APIs
USE_LOCAL_MODELS=True

# Hugging Face model names (free to use)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
SUMMARIZATION_MODEL_NAME=facebook/bart-large-cnn


# YouTube Data API v3 (optional - for video reviews)
# Get free key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ========================================
# REDDIT API - OPTIONAL
# ========================================
# Get credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ClarifyProducts.AI/1.0

# ========================================
# TWITTER/X API - OPTIONAL
# ========================================
# Get credentials: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ========================================
# ML MODEL PATHS
# ========================================
CLIP_MODEL_PATH=./models/clip
SENTIMENT_MODEL_PATH=./models/sentiment
RECOMMENDATION_MODEL_PATH=./models/recommendation

# ========================================
# CELERY TASK QUEUE
# ========================================
# For background tasks (scraping, ML processing)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========================================
# AWS S3 - OPTIONAL
# ========================================
# For storing product images in cloud
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=clarifyproducts-images
AWS_REGION=us-east-1

# ========================================
# MONITORING - OPTIONAL
# ========================================
# Sentry for error tracking in production
SENTRY_DSN=

# ========================================
# API SETTINGS
# ========================================
# Rate limiting (requests per minute per user)
RATE_LIMIT_PER_MINUTE=60

# ========================================
# WEB SCRAPING SETTINGS
# ========================================
# Delay between requests (be respectful to servers)
SCRAPING_DELAY_SECONDS=2

# Maximum reviews to fetch per source
MAX_REVIEWS_PER_SOURCE=100

# Cache expiration in hours
CACHE_TTL_HOURS=24

# ========================================
# IMPORTANT NOTES
# ========================================
# 1. Never commit the actual .env file to git!
# 2. .env is already in .gitignore
# 3. Generate strong SECRET_KEY for production
# 4. Most external APIs are optional - local models work great!
# 5. Update DATABASE_URL with your actual PostgreSQL credentials
